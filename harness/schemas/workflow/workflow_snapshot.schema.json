{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecmonitor.local/schemas/workflow/workflow_snapshot.schema.json",
  "title": "Workflow Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["workflow_run_id", "state", "revision", "history"],
  "properties": {
    "workflow_run_id": {"type": "string", "minLength": 1},
    "state": {"enum": ["created", "retrieving", "screening", "download_queued", "downloading", "extracting", "validating", "committing", "paused_human_review", "blocked_access", "failed_retryable", "failed_terminal", "completed", "cancelled"]},
    "revision": {"type": "integer", "minimum": 0},
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from_state", "to_state", "occurred_at", "actor", "reason_code", "metadata"],
        "properties": {
          "from_state": {"type": "string"},
          "to_state": {"type": "string"},
          "occurred_at": {"type": "string", "format": "date-time"},
          "actor": {"type": "string"},
          "reason_code": {"type": "string"},
          "metadata": {"type": "object"}
        }
      }
    }
  }
}
