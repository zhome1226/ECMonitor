    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "field_checks",
        "reason_codes",
        "requested_context",
        "attempt",
        "validated_at",
        "human_review_required",
        "human_review_triggers",
        "human_review_status"
      ],
      "properties": {
        "decision": {
          "enum": [
            "pending",
            "accept",
            "retry",
            "escalate",
            "reject"
          ]
        },
        "field_checks": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/fieldCheck"
          }
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requested_context": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "validated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "human_review_required": {
          "type": "boolean"
        },
        "human_review_triggers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "human_review_status": {
          "enum": [
            "not_required",
            "pending",
            "approved",
            "rejected",
            "needs_correction"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "human_review_required": {
                "const": true
              }
            },
            "required": [
              "human_review_required"
            ]
          },
          "then": {
            "properties": {
              "human_review_triggers": {
                "minItems": 1
              },
              "human_review_status": {
                "enum": [
                  "pending",
                  "approved",
                  "rejected",
                  "needs_correction"
                ]
              }
            }
          }
        }
      ]
    },
