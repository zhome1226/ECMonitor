    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_text",
        "country",
        "admin1",
        "water_body",
        "site_name",
        "latitude",
        "longitude",
        "coordinate_source",
        "spatial_precision"
      ],
      "properties": {
        "raw_text": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "country": {
          "$ref": "#/$defs/nullableString"
        },
        "admin1": {
          "$ref": "#/$defs/nullableString"
        },
        "water_body": {
