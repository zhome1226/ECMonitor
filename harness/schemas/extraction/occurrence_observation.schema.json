        },
        "site_name": {
          "$ref": "#/$defs/nullableString"
        },
        "latitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "coordinate_source": {
          "enum": [
            "reported",
            "geocoded",
            "centroid",
            "inferred",
            "not_available"
          ]
        },
        "spatial_precision": {
          "enum": [
            "exact_coordinate",
            "site",
            "water_body",
            "city",
            "admin1",
            "country",
            "unknown"
          ]
        },
        "country_iso2": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{2}$"
        },
        "geocode_country_iso2": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{2}$"
        },
        "admin_hierarchy_validated": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "admin_hierarchy_consistent": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "admin_hierarchy_conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "latitude": {
                "type": "number"
              }
            },
            "required": [
              "latitude"
            ]
          },
          "then": {
            "properties": {
              "longitude": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "longitude": {
                "type": "number"
              }
            },
            "required": [
              "longitude"
            ]
          },
          "then": {
            "properties": {
              "latitude": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
