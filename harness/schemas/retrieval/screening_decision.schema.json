{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScreeningDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "screening_schema_version",
    "screening_decision_id",
    "global_record_id",
    "run_id",
    "query_id",
    "iteration",
    "screening_pass",
    "decision",
    "confidence",
    "article_type_ok",
    "date_ok",
    "scie_status",
    "emerging_contaminant_context",
    "surface_water_sample",
    "included_waterbody_types",
    "excluded_sample_matrices_present",
    "excluded_sample_matrices",
    "water_treatment_plant_samples_present",
    "mixed_eligible_ineligible_matrices",
    "field_environmental_samples",
    "concentration_evidence",
    "study_type",
    "reason_codes",
    "evidence_spans",
    "query_term_evidence",
    "prompt_version",
    "prompt_hash",
    "model_name",
    "model_version",
    "model_parameters",
    "raw_model_response_path",
    "screening_timestamp",
    "decision_actor",
    "audit_status",
    "audit_sampled",
    "audit_batch_id",
    "manager_decision",
    "manager_reason",
    "screening_disagreement",
    "original_agent_decision",
    "override_decision",
    "override_actor",
    "override_reason",
    "override_timestamp",
    "article_ec_scope",
    "screening_version"
  ],
  "properties": {
    "screening_schema_version": {"type": "string"},
    "screening_decision_id": {"type": "string", "minLength": 1},
    "global_record_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string"},
    "query_id": {"type": "string"},
    "iteration": {"type": "integer", "minimum": 0},
    "screening_pass": {"type": "string"},
    "decision": {
      "type": "string",
      "enum": ["include", "exclude", "defer_metadata", "defer_not_downloaded"]
    },
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "article_type_ok": {"type": ["boolean", "null"]},
    "date_ok": {"type": ["boolean", "null"]},
    "scie_status": {
      "type": "string",
      "enum": ["matched", "not_matched", "unknown", "registry_unavailable"]
    },
    "emerging_contaminant_context": {"type": ["boolean", "null"]},
    "surface_water_sample": {"type": ["boolean", "null"]},
    "included_waterbody_types": {"type": "array", "items": {"type": "string"}},
    "excluded_sample_matrices_present": {"type": "boolean"},
    "excluded_sample_matrices": {"type": "array", "items": {"type": "string"}},
    "water_treatment_plant_samples_present": {"type": "boolean"},
    "mixed_eligible_ineligible_matrices": {"type": "boolean"},
    "field_environmental_samples": {"type": ["boolean", "null"]},
    "concentration_evidence": {
      "type": "string",
      "enum": [
        "explicit_numeric",
        "explicit_quantified",
        "semi_quantitative",
        "likely_but_not_explicit",
        "absent"
      ]
    },
    "study_type": {"type": ["string", "null"]},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "evidence_spans": {"type": "array", "items": {"type": "string"}},
    "query_term_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "concept_block",
          "evidence_span",
          "why_relevant",
          "confidence"
        ],
        "properties": {
          "term": {"type": "string", "minLength": 1},
          "concept_block": {
            "type": "string",
            "enum": [
              "emerging_contaminant_terms",
              "surface_water_terms",
              "monitoring_and_concentration_terms",
              "optional_context_terms",
              "exclusion_candidate_terms"
            ]
          },
          "evidence_span": {"type": "string"},
          "why_relevant": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "prompt_version": {"type": "string"},
    "prompt_hash": {"type": "string"},
    "model_name": {"type": "string"},
    "model_version": {"type": "string"},
    "model_parameters": {"type": "object"},
    "raw_model_response_path": {"type": ["string", "null"]},
    "screening_timestamp": {"type": "string"},
    "decision_actor": {"type": "string"},
    "audit_status": {"type": "string"},
    "audit_sampled": {"type": "boolean"},
    "audit_batch_id": {"type": ["string", "null"]},
    "manager_decision": {"type": ["string", "null"]},
    "manager_reason": {"type": ["string", "null"]},
    "screening_disagreement": {"type": "boolean"},
    "original_agent_decision": {"type": ["string", "null"]},
    "override_decision": {"type": ["string", "null"]},
    "override_actor": {"type": ["string", "null"]},
    "override_reason": {"type": ["string", "null"]},
    "override_timestamp": {"type": ["string", "null"]},
    "article_ec_scope": {"type": "string"},
    "screening_version": {"type": "string"}
  }
}
