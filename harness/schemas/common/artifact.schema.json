{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecmonitor.local/schemas/common/artifact.schema.json",
  "title": "ECMonitor Artifact Reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "artifact_type", "uri", "sha256", "created_at", "contains_restricted_content"],
  "properties": {
    "artifact_id": {"type": "string", "minLength": 1},
    "artifact_type": {"type": "string", "minLength": 1},
    "uri": {"type": "string", "minLength": 1},
    "sha256": {"type": ["string", "null"], "pattern": "^(?:[a-fA-F0-9]{64})?$"},
    "created_at": {"type": "string", "format": "date-time"},
    "contains_restricted_content": {"type": "boolean"},
    "metadata": {"type": "object"}
  }
}
