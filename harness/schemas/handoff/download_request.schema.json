{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DownloadRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handoff_schema_version",
    "event_id",
    "event_type",
    "idempotency_key",
    "run_id",
    "iteration",
    "query_id",
    "global_record_id",
    "document_version",
    "normalized_DOI",
    "PMID",
    "OpenAlex_ID",
    "Semantic_Scholar_ID",
    "Crossref_ID",
    "title",
    "authors",
    "first_author",
    "publication_year",
    "journal_title",
    "ISSN",
    "eISSN",
    "language",
    "document_type",
    "scie_status",
    "source_metadata_paths",
    "source_provenance",
    "candidate_fulltext_urls",
    "open_access_status",
    "screening_decision",
    "screening_confidence",
    "screening_reason_codes",
    "screening_evidence_path",
    "retrieval_lane",
    "priority",
    "requested_at",
    "payload_checksum"
  ],
  "properties": {
    "handoff_schema_version": {"type": "string"},
    "event_id": {"type": "string"},
    "event_type": {"type": "string", "enum": ["DOWNLOAD_REQUESTED", "ELIGIBILITY_REVOKED", "DOWNLOAD_CANCEL_REQUESTED"]},
    "idempotency_key": {"type": "string"},
    "run_id": {"type": "string"},
    "iteration": {"type": "integer"},
    "query_id": {"type": "string"},
    "global_record_id": {"type": "string"},
    "document_version": {"type": "string"},
    "normalized_DOI": {"type": ["string", "null"]},
    "PMID": {"type": ["string", "null"]},
    "OpenAlex_ID": {"type": ["string", "null"]},
    "Semantic_Scholar_ID": {"type": ["string", "null"]},
    "Crossref_ID": {"type": ["string", "null"]},
    "title": {"type": "string"},
    "authors": {"type": "array", "items": {"type": "string"}},
    "first_author": {"type": ["string", "null"]},
    "publication_year": {"type": ["integer", "null"]},
    "journal_title": {"type": ["string", "null"]},
    "ISSN": {"type": "array", "items": {"type": "string"}},
    "eISSN": {"type": "array", "items": {"type": "string"}},
    "language": {"type": ["string", "null"]},
    "document_type": {"type": ["string", "null"]},
    "scie_status": {"type": "string"},
    "source_metadata_paths": {"type": "array", "items": {"type": "string"}},
    "source_provenance": {"type": "array", "items": {"type": "object"}},
    "candidate_fulltext_urls": {"type": "array", "items": {"type": "string"}},
    "open_access_status": {"type": ["string", "null"]},
    "screening_decision": {"type": "string"},
    "screening_confidence": {"type": ["number", "null"]},
    "screening_reason_codes": {"type": "array", "items": {"type": "string"}},
    "screening_evidence_path": {"type": "string"},
    "retrieval_lane": {"type": "string"},
    "priority": {"type": "integer"},
    "requested_at": {"type": "string"},
    "payload_checksum": {"type": "string"}
  }
}
