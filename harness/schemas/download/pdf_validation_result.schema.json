{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecmonitor.local/schemas/download/pdf_validation_result.schema.json",
  "title": "PDF Validation Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["path", "valid", "sha256", "byte_size", "page_count", "reason_codes", "parser"],
  "properties": {
    "path": {"type": "string"},
    "valid": {"type": "boolean"},
    "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "byte_size": {"type": "integer", "minimum": 0},
    "page_count": {"type": ["integer", "null"], "minimum": 0},
    "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "parser": {"type": ["string", "null"]}
  }
}
